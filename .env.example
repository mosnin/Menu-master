# =============================================================================
# Deal Desk — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] enable additional features but are not required.

# =============================================================================
# Auth0  [REQUIRED]
# =============================================================================
# Generate a random secret: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-random-string-at-least-32-chars

# Local dev: http://localhost:3000
# Staging:   https://staging.yourdomain.com
# Prod:      https://app.yourdomain.com
AUTH0_BASE_URL=http://localhost:3000

# Your Auth0 tenant URL (found in Auth0 Dashboard > Settings)
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com

# Auth0 Application credentials (Dashboard > Applications > Your App)
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Auth0 callback URLs to configure in the dashboard:
#   Allowed Callback URLs:      {AUTH0_BASE_URL}/auth/callback
#   Allowed Logout URLs:        {AUTH0_BASE_URL}
#   Allowed Web Origins:        {AUTH0_BASE_URL}
# For staging/prod, add those domains to the same Auth0 application.

# =============================================================================
# Supabase  [REQUIRED]
# =============================================================================
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Notes:
# - Run migrations before first use: pnpm db:migrate
# - Create the "documents" storage bucket in Supabase Dashboard > Storage
# - Service role key is only used server-side; never expose to the client

# =============================================================================
# OpenAI  [OPTIONAL]
# =============================================================================
# Required for AI document classification and field extraction.
# Without this key, AI features are disabled and documents require manual review.
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# Resend  [OPTIONAL]
# =============================================================================
# Required for sending outbound emails.
# Without these, emails are logged to the console instead of sent.
RESEND_API_KEY=re_your-resend-api-key

# The "From" address for outbound emails.
# Must match a verified domain in Resend.
# Staging: use Resend test domain (onboarding@resend.dev)
# Prod:    use your verified domain (noreply@yourdomain.com)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Inngest  [OPTIONAL in dev, RECOMMENDED in production]
# =============================================================================
# Powers async workflows (document processing, reminders).
# In local dev, run `pnpm inngest:dev` to start the Inngest dev server.
# In production, set these from the Inngest dashboard.
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
